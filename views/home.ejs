<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drive Clone - File Upload</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Flowbite CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/flowbite@3.1.1/dist/flowbite.min.css"
      rel="stylesheet"
    />
    <!-- GSAP -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  </head>
  <body
    class="flex flex-col items-center justify-center min-h-screen bg-gray-100"
  >
    <main class="p-6 text-center w-full max-w-2xl">
      <!-- Main Upload Button -->
      <button
        type="button"
        class="bg-blue-500 text-white font-bold py-4 px-8 rounded-full shadow-lg transform transition-all duration-300 hover:scale-105 hover:shadow-2xl text-lg"
        onclick="triggerFileInput()"
        id="uploadBtn"
        style="
          background: linear-gradient(135deg, #00bfff 0%, #1e90ff 100%);
          box-shadow: 0 8px 20px rgba(0, 191, 255, 0.3);
        "
      >
        Upload File
      </button>

      <!-- Hidden File Input (triggered by the main button) -->
      <input
        type="file"
        id="fileInput"
        class="hidden"
        onchange="handleFileUpload(event)"
      />

      <!-- File Name Display (below the button) -->
      <p
        id="fileName"
        class="mt-3 text-gray-600 opacity-0 transition-opacity duration-500"
      ></p>

      <!-- Drag & Drop Area -->
      <div
        id="dropzone"
        class="mt-6 w-full max-w-2xl h-72 flex flex-col items-center justify-center border-4 border-dashed border-blue-400 bg-white shadow-lg rounded-lg cursor-pointer transition-all duration-300 hover:bg-gray-100"
        ondragover="handleDragOver(event)"
        ondragleave="handleDragLeave(event)"
        ondrop="handleDrop(event)"
        onclick="document.getElementById('dropzone-file').click()"
      >
        <svg
          class="w-16 h-16 mb-4 text-gray-500"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 16V4m0 0L3 8m4-4l4 4m5 8v-8m0 0l4 4m-4-4l-4 4"
          />
        </svg>
        <p class="mb-2 text-lg text-gray-700 font-semibold">
          Drag & Drop files here
        </p>
        <p class="text-sm text-gray-500">or click to upload (Max: 800x400px)</p>
        <!-- Hidden File Input for Dropzone -->
        <input
          id="dropzone-file"
          type="file"
          class="hidden"
          name="file"
          onchange="handleFileUpload(event)"
        />
      </div>
    </main>

    <!-- Modal for Final File Upload Confirmation -->
    <!-- The backdrop now uses a blur effect -->
    <div
      id="uploadModal"
      class="hidden fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm"
    >
      <div class="bg-white rounded-lg p-6 w-full max-w-md">
        <h2 class="text-xl font-bold mb-4">Confirm File Upload</h2>
        <p id="modalFileName" class="mb-4"></p>
        <!-- Final Upload Form -->
        <!-- Update the action attribute to point to your backend endpoint -->
        <form action="/upload" method="post" enctype="multipart/form-data">
          <!-- In a real implementation, you would send the actual file (via FormData, etc.) -->
          <input type="hidden" name="fileName" id="modalHiddenFileName" />
          <button
            type="submit"
            class="bg-blue-500 text-white py-2 px-4 rounded-full shadow hover:bg-blue-700 transition-all duration-300 w-full"
          >
            Upload File
          </button>
        </form>
        <button
          onclick="closeModal()"
          class="mt-4 text-gray-600 hover:text-gray-800"
        >
          Cancel
        </button>
      </div>
    </div>

    <!-- Flowbite JS -->
    <script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.1/dist/flowbite.min.js"></script>
    <script src="/config/supabase.config.js"></script>
    <script>
      // Trigger the hidden file input when the main upload button is clicked
      function triggerFileInput() {
        document.getElementById("fileInput").click();
        gsap.fromTo(
          "#uploadBtn",
          { scale: 1.1 },
          { scale: 1, duration: 0.2, ease: "bounce.out" }
        );
      }

      // Handle file selection (from either the button or dropzone)
      async function handleFileUpload(event) {
        const file = event.target.files[0];
        if (file) {
          displayFileName(file.name);
          showModal(file.name);
          await uploadFile(file); // Call the uploadFile function here
        }
      }

      // Visual feedback when dragging over the dropzone
      function handleDragOver(event) {
        event.preventDefault();
        document.getElementById("dropzone").classList.add("bg-blue-50");
      }

      // Remove visual feedback when drag leaves the dropzone
      function handleDragLeave(event) {
        document.getElementById("dropzone").classList.remove("bg-blue-50");
      }

      // Handle file drop event
      async function handleDrop(event) {
        event.preventDefault();
        document.getElementById("dropzone").classList.remove("bg-blue-50");
        const file = event.dataTransfer.files[0];
        if (file) {
          displayFileName(file.name);
          showModal(file.name);
          await uploadFile(file); // Call the uploadFile function here
        }
      }

      // Display the selected file name below the main upload button
      function displayFileName(fileName) {
        const fileNameDisplay = document.getElementById("fileName");
        fileNameDisplay.textContent = "Selected: " + fileName;
        fileNameDisplay.classList.remove("opacity-0");
        gsap.fromTo(
          "#fileName",
          { opacity: 0, y: -10 },
          { opacity: 1, y: 0, duration: 0.5 }
        );
      }

      // Show the modal with file details for final confirmation
      function showModal(fileName) {
        const modal = document.getElementById("uploadModal");
        const modalFileName = document.getElementById("modalFileName");
        const modalHiddenFileName = document.getElementById(
          "modalHiddenFileName"
        );
        modalFileName.textContent = "File: " + fileName;
        modalHiddenFileName.value = fileName; // Placeholder value; in practice, send the actual file
        modal.classList.remove("hidden");
      }

      // Close the modal and remove blur effect from background
      function closeModal() {
        const modal = document.getElementById("uploadModal");
        modal.classList.add("hidden");
      }

      // Function to upload file to Supabase
      // const uploadFile = async (file) => {
      //   const { data, error } = await supabase.storage
      //     .from("drive_files")
      //     .upload(`uploads/${file.name}`, file, { upsert: true });

      //   if (error) {
      //     console.error("Upload error:", error);
      //   } else {
      //     console.log("File uploaded:", data);
      //   }
      // };
    </script>
  </body>
</html>
